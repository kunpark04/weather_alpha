# Logs (backfill_hrrr.py writes a multi-hundred-MB log)
*.log

# Local Claude Code agent state
.claude/

# Data parquets/CSVs are derivable (refresh_data.py / backfill_hrrr.py / analysis scripts)
data/*.parquet
data/*.csv

# Runtime state for the bot (positions snapshot, kill switch, scheduler state)
data/positions.json
data/KILL_SWITCH
data/scheduler_state.json

# Per-process runtime dirs (per-city state + orderbook captures — public data, not secret)
data/live/
data/paper/
data/orderbook/
data/state_inbox/
data/state_archive/

# Analysis outputs are derivable from the committed scripts (regenerate, don't version):
#   data/backfill/  -- raw trade-history zips (via backfill_cities.py / backfill_historical.py)
#   data/analysis/  -- coverage/edge datasets + READMEs (via build_analysis_datasets.py)
#   data/*.txt      -- analysis table dumps (anchor grids, monthly edge, ...)
#   data/noaa_actuals/ -- fetched NOAA daily-high cache (forecastability test)
data/backfill/
data/analysis/
data/*.txt
data/noaa_actuals/
# directional paper-test logs pulled from the droplet (runtime data)
data/directional_paper/
# Rust engine state/log (runtime)
data/wa_engine/
# stray local temp artifacts
_tmp_*

# Subagent coordination artifacts (transient)
tasks/_agent_bus/
