# systemd --user variant of the orderbook logger: logs bid/ask + depth ladders for ALL 20 daily-high
# series. Authenticated READ-ONLY via EnvironmentFile (the RW key, GET-only -> higher rate-limit tier;
# '-' = falls back to keyless if absent). Installed by deploy/setup-local.sh (rewrites %h/weather-alpha
# to your clone path). Manual install: cp to ~/.config/systemd/user/ only if your clone is at ~/weather-alpha.
[Unit]
Description=Kalshi daily-high orderbook logger (weather-alpha, --user)

[Service]
Type=simple
WorkingDirectory=%h/weather-alpha
EnvironmentFile=-%h/weather-alpha/secrets/kalshi-rw.env
ExecStart=%h/weather-alpha/.venv/bin/python %h/weather-alpha/scripts/orderbook_logger.py --interval 60 --out %h/weather-alpha/data/orderbook --series KXHIGHCHI,KXHIGHTHOU,KXHIGHNY,KXHIGHMIA,KXHIGHAUS,KXHIGHDEN,KXHIGHPHIL,KXHIGHLAX,KXHIGHTLV,KXHIGHTNOLA,KXHIGHTSEA,KXHIGHTSFO,KXHIGHTDC,KXHIGHTATL,KXHIGHTMIN,KXHIGHTPHX,KXHIGHTBOS,KXHIGHTDAL,KXHIGHTOKC,KXHIGHTSATX
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
