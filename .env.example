# Copy to .env (gitignored) and fill in for LIVE mode.
# PAPER mode does not need any of these.

# Kalshi API credentials (production)
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Synoptic Data Mesonet API (real-time ASOS — closes the IEM lag).
# Free tier at https://synopticdata.com/  ~5k calls/month is plenty for one bot.
SYNOPTIC_TOKEN=

# Optional config override
# WEATHER_ALPHA_CONFIG=/abs/path/to/custom.yaml
